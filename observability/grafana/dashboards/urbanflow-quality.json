{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat", "title": "Tests executed", "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(urbanflow_test_executed_total)", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Pass rate", "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 0.98 }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(urbanflow_test_passed_total) / clamp_min(sum(urbanflow_test_executed_total), 1)", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "API latency p50 / p95 / p99", "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "type": "timeseries", "title": "Test duration percentiles", "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, suite) (rate(urbanflow_test_duration_seconds_bucket[15m])))", "legendFormat": "{{suite}} p95", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Kafka lag, retries and DLT", "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(urbanflow_kafka_consumer_lag)", "legendFormat": "lag", "refId": "A" },
        { "expr": "sum(rate(urbanflow_kafka_retry_total[5m]))", "legendFormat": "retry/s", "refId": "B" },
        { "expr": "sum(increase(urbanflow_kafka_dlt_total[5m]))", "legendFormat": "DLT", "refId": "C" }
      ]
    },
    {
      "type": "timeseries", "title": "Outbox publication and backlog", "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "expr": "sum(rate(urbanflow_outbox_publication_total[5m])) by (result)", "legendFormat": "{{result}}/s", "refId": "A" },
        { "expr": "sum(urbanflow_outbox_ready_backlog)", "legendFormat": "ready", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "End-to-end journey duration", "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, journey) (rate(urbanflow_e2e_duration_seconds_bucket[15m])))", "legendFormat": "{{journey}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Failure and flaky rate", "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        { "expr": "sum(rate(urbanflow_test_failed_total[15m]))", "legendFormat": "failed/s", "refId": "A" },
        { "expr": "sum(rate(urbanflow_test_flaky_total[15m]))", "legendFormat": "flaky/s", "refId": "B" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["urbanflow", "quality-engineering"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "UrbanFlow Quality Engineering",
  "uid": "urbanflow-quality",
  "version": 1
}
