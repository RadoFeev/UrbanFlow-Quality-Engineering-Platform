URBANFLOW_ENV=local
URBANFLOW_BASE_URL=http://localhost:8080
URBANFLOW_BROWSER=chrome
URBANFLOW_HEADLESS=true
URBANFLOW_PARALLELISM=4
URBANFLOW_VIDEO=false
URBANFLOW_CLEANUP=true
POSTGRES_USER=urbanflow
# Set these three values in a local .env file or secret manager before Compose startup.
POSTGRES_PASSWORD=
IDENTITY_SIGNING_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Provide secrets in the shell or secret manager; never put secret values here.
